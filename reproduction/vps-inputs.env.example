# HomeRoute VPS clean-reproduction inputs.
# Copy to a local ignored file. Never commit populated values.

HOMEROUTE_REPRO_VPS_ROOT="CHANGE_ME"

# Exact verified rescue artifacts copied from the reference VPS.
HOMEROUTE_REPRO_AWG_STATE="CHANGE_ME/awg-state"
HOMEROUTE_REPRO_ADGUARD_STATE="CHANGE_ME/adguard-state"
HOMEROUTE_REPRO_AWG_IMAGE="CHANGE_ME/awg-image"
HOMEROUTE_REPRO_ADGUARD_IMAGE="CHANGE_ME/adguard-image"

# Target-local paths. These are intentionally not stored in public manifests.
HOMEROUTE_REPRO_ADGUARD_CONF_HOST_PATH="CHANGE_ME"
HOMEROUTE_REPRO_ADGUARD_WORK_HOST_PATH="CHANGE_ME"

# Target-local AWG UDP host port. Reference container port is 35404/udp.
HOMEROUTE_REPRO_AWG_HOST_UDP_PORT="CHANGE_ME"

# Reproduction target identity (for evidence only; do not use credentials here).
HOMEROUTE_REPRO_TARGET_LABEL="CHANGE_ME"
